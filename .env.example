# Server-side only. Visitors can also paste their own key in the app.
TOGETHER_API_KEY=

# Postgres on Neon. Create the tables with `npm run db:migrate`.
DATABASE_URL=

# Clerk. Accounts are optional; signed in, notes and highlights sync across devices.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# The public origin, for canonical and social card URLs.
NEXT_PUBLIC_SITE_URL=https://usegloss.io

# Exa web search, for Fact-check and questions asked with Web on. Optional: without it answers stay inside the text.
EXA_API_KEY=

# LlamaParse, behind "Read it more carefully" on hard PDFs. Optional; only readers with their own Together key can use it.
LLAMA_CLOUD_API_KEY=

# Printed editions: a month's reading as a 6 × 9 paperback, $25 posted (US).
# Shown in production only with NEXT_PUBLIC_EDITIONS=1; always on in development.
NEXT_PUBLIC_EDITIONS=
# Stripe Checkout takes the payment and the shipping address. Without it, local runs use a test checkout (no card, nothing printed).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Lulu prints and posts. LULU_SANDBOX=1 uses api.sandbox.lulu.com, which never prints.
LULU_CLIENT_KEY=
LULU_CLIENT_SECRET=
LULU_SANDBOX=
# Where Lulu sends questions about a print job (yours, not the reader's).
LULU_CONTACT_EMAIL=
# Vercel Blob keeps the PDFs where Lulu can fetch them.
BLOB_READ_WRITE_TOKEN=
# Optional: Prince at DocRaptor sets the book instead of Chrome with Paged.js. Test documents (watermarked) everywhere but production.
DOCRAPTOR_API_KEY=
